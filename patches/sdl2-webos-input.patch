+static SDL_Scancode Wayland_webos_navigation_scancode(struct SDL_WaylandInput *input, uint32_t key)
+{
+    const xkb_keysym_t *syms;
+    if (input->xkb.state && WAYLAND_xkb_state_key_get_syms(input->xkb.state, key + 8, &syms) == 1) {
+        switch (syms[0]) {
+        case XKB_KEY_Up: return SDL_SCANCODE_UP;
+        case XKB_KEY_Down: return SDL_SCANCODE_DOWN;
+        case XKB_KEY_Left: return SDL_SCANCODE_LEFT;
+        case XKB_KEY_Right: return SDL_SCANCODE_RIGHT;
+        case XKB_KEY_Return:
+        case XKB_KEY_Select: return SDL_SCANCODE_RETURN;
+        case XKB_KEY_KP_Enter: return SDL_SCANCODE_KP_ENTER;
+        }
+    }
+    /* Linux KEY_OK and KEY_SELECT are outside the stock PC scancode table. */
+    if (key == 0x160 || key == 0x161) {
+        return SDL_SCANCODE_RETURN;
+    }
+    return SDL_SCANCODE_UNKNOWN;
+}
